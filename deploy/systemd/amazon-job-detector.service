[Unit]
Description=Amazon SMF1/SMF6 hourly-job detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match your VPS.
User=amazon
WorkingDirectory=/opt/amazon-job-detector
Environment=PYTHONPATH=/opt/amazon-job-detector/src
EnvironmentFile=/opt/amazon-job-detector/.env
ExecStart=/opt/amazon-job-detector/.venv/bin/python -m amazon_job_detector run --config /opt/amazon-job-detector/config.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
