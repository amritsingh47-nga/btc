# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Amazon session token (see README "Getting your auth token") ---
# Paste the full value of the Authorization request header from hiring.amazon.com.
AMZ_AUTH_TOKEN=

# --- Telegram (fastest alerts) ---
# 1. Message @BotFather on Telegram, /newbot, copy the token here.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optional) ---
# In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook,
# pick the channel, "Copy Webhook URL", paste it here.
# DISCORD_WEBHOOK_URL=

# --- SMS via Twilio (optional) ---
# From your Twilio console dashboard. (from_number/to_number go in config.yaml.)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
