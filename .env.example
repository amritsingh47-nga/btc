# =====================================================================
# Analysts Trading Bot — environment configuration
#
# 1. Copy this file to .env
# 2. Fill in what you have; the app runs (degraded, clearly labeled)
#    without any optional key
# 3. .env is gitignored — NEVER commit it. If a secret leaks, rotate it.
# =====================================================================

# ----------------------------------------------------------------------
# REQUIRED — Discord alerts
# Paste your Discord webhook URL (Server Settings → Integrations →
# Webhooks). Treat it as a secret; rotate it in Discord if it leaks.
# ----------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# Batch PASS messages into an hourly digest (TAKEs always post at once).
# Default false = post everything.
DISCORD_QUIET_MODE=false

# ----------------------------------------------------------------------
# OPTIONAL — free API keys (features degrade cleanly without them)
# ----------------------------------------------------------------------
# Macro module — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Stocks news + earnings calendar — free key: https://finnhub.io/register
FINNHUB_API_KEY=

# ----------------------------------------------------------------------
# OPTIONAL — LLM (enables LLM agent variants, Bull/Bear LLM debate,
# LLM sentiment). Rule-based agents run fine without it.
# Providers: claude, openai, deepseek, qwen, gemini, kimi, minimax, glm,
# openrouter
# ----------------------------------------------------------------------
LLM_PROVIDER=
CLAUDE_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ----------------------------------------------------------------------
# OPTIONAL — News module
# Truth Social RSS mirror for Trump-post monitoring. Mirrors come and
# go — if the default dies, find a working one and put it here.
# The official Truth Social API (institutional/paid) and paid scraper
# APIs are intentionally NOT supported; a future upgrade could slot in
# here if that ever changes.
# ----------------------------------------------------------------------
TRUMP_RSS_URL=https://trumpstruth.org/feed

# ----------------------------------------------------------------------
# OPTIONAL — dashboard login. Leave empty for open access on localhost/
# Tailscale (recommended for personal use). Set a password to require
# login on the web UI.
# ----------------------------------------------------------------------
WEB_PASSWORD=

# ----------------------------------------------------------------------
# Advanced (defaults are correct for normal use)
# ----------------------------------------------------------------------
# Market data source: yfinance (real, default) | synthetic (offline demo)
# DATA_SOURCE=yfinance
# Override the futures universe (yfinance symbols, comma-separated)
# TRADING_SYMBOLS=NQ=F,ES=F,GC=F,CL=F

# NOTE: There are intentionally no Binance/broker/exchange credentials
# in this file. This system is signals-only and can never trade.
